# Keep the real file ONLY on EC2 at ~/multi-agent-09/shared/app.env (chmod 600).
# URL-encode special characters in username/password. Replace the DB endpoint.
DATABASE_URL=postgresql://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/DB_NAME?connect_timeout=5
REDIS_URL=redis://redis:6379/0
TRAVEL_MCP_URL=http://mcp:8010/mcp
# Start with one provider; no Ollama server is provisioned on EC2.
LLM_PROVIDER=openai
SUPERVISOR_PROVIDER=openai
WEATHER_AGENT_PROVIDER=openai
PLACE_AGENT_PROVIDER=openai
BUDGET_AGENT_PROVIDER=openai
ITINERARY_AGENT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TASK_TTL_SECONDS=3600
MAX_ORCHESTRATION_STEPS=8
